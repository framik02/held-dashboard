{
  "name": "held-dashboard",
  "main": "auth/worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-auth",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth/*",
      "/api/*"
    ]
  },
  "vars": {
    "HELD_REPO": "framik02/held-wiki",
    "APP_ORIGIN": "https://held-dashboard.chiarolanza-francesco.workers.dev",
    "GITHUB_CLIENT_ID": ""
  },
  "account_id": "a674a0f074b8c389ad40bf022c6bbd74",
  "observability": {
    "enabled": false
  }
}
